# Cloudflare Pages cache rules.
# Files under /app/* are rebuilt and re-deployed on every push, so we
# can't let WebView / browser cache them — users were stuck on the
# v5 layout for hours because LOAD_DEFAULT honored long cache TTLs.

/app/*
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

# Hashed Vite assets (`/assets/foo-abc123.js`) are content-addressed,
# so they're safe to cache aggressively.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
